# Planned configuration surface. Copy to config/app.env before running.
# No secrets in this file — it is committed.

# --- Database ---
# Host/Make path: developer-managed local PostgreSQL. Compose overrides this inside
# the API container with its private db:5432 address; development Compose may expose
# the container separately on POSTGRES_HOST_PORT (default 5433).
# Use a dedicated database — never the shared `postgres` DB (other projects' Alembic
# revisions will collide). `make db-create` creates these databases if missing; the
# role below must already exist with CREATEDB (or be a superuser). Alembic creates
# the application schema `career_assistant` on migrate.
DATABASE_URL=postgresql+psycopg://career:career@localhost:5432/career_assistant
# Integration tests must use a separate disposable database. Phase 4 makes the test
# target refuse to run if this equals DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://career:career@localhost:5432/career_assistant_test

# Compose-only development defaults. Deployment must override the password and must
# not publish the database port; see PLAN Phase 16.
POSTGRES_USER=career
POSTGRES_PASSWORD=career
POSTGRES_DB=career_assistant
POSTGRES_HOST_PORT=5433

# --- Web tier -------------------------------------------------------------
# The browser only ever talks to the web origin. The TanStack Start server
# proxies /api/** to the backend. This is a SERVER variable — never VITE_*,
# which would compile it into browser code.
# Host `make run` binds the web app to WEB_PORT (default 3000). Do not use the
# Lovable sandbox default (8080) unless WEB_ORIGIN matches that port.
API_BASE_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000

# --- Providers -------------------------------------------------------------
# Completion and embeddings are chosen independently.
# ollama | openai | anthropic   (anthropic has no embedding model)
# Local by default: run `ollama serve` and pull the models named below.
# The hermetic adapters are a test fixture, not a deployment option — the test
# suite selects them so it runs with no key, no network and no model download.
# Deciding what counts as a requirement is a language task; see PLAN 13C.
COMPLETION_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# Hosted providers are unreachable unless this is true AND a key is present.
# This is the egress gate. Leave it false for a local-only deployment.
ALLOW_HOSTED_PROVIDERS=false

# Local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_COMPLETION_MODEL=
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Hosted — leave blank to keep that provider unavailable.
# Keys are read here and nowhere else. No route accepts, returns or displays
# one, in any shape, including masked.
# Defaults match ProviderSettings when the vars are empty.
OPENAI_API_KEY=
OPENAI_COMPLETION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_COMPLETION_MODEL=

# Per-provider resilience
PROVIDER_TIMEOUT_SECONDS=60
PROVIDER_MAX_RETRIES=2
PROVIDER_BREAKER_FAILURE_THRESHOLD=5
# Whether a failed hosted call may fall back to the local provider.
# When true the response says a fallback happened. Never silent.
PROVIDER_ALLOW_LOCAL_FALLBACK=false

# Cost accounting — used for the per-provider comparison in docs/evaluation.md
TRACK_TOKEN_USAGE=true

# --- Scoring rubric --------------------------------------------------------
# The rubric is configuration, not literals in the code. Documented in
# docs/features.md; changing these changes every stored score, so re-score.
SCORE_WEIGHT_MUST=3
SCORE_WEIGHT_DESIRABLE=1
SCORE_FACTOR_MET=1.0
SCORE_FACTOR_PARTIAL=0.5
SCORE_RECENCY_RECENT_YEARS=2
SCORE_RECENCY_MID_YEARS=5
SCORE_RECENCY_FACTOR_MID=0.85
SCORE_RECENCY_FACTOR_OLD=0.7
SCORE_BAND_STRONG=75
SCORE_BAND_PARTIAL=50

# --- Generation ------------------------------------------------------------
# Drafts are bound to their cited spans and validated server-side (ADR 007).
GENERATION_ENABLED=true
# Regeneration attempts after a failed groundedness check, before the
# deterministic template path is used instead.
GENERATION_MAX_REGENERATIONS=1
# A cover letter is refused below this many met must-have requirements.
COVER_LETTER_MIN_MET_MUSTS=2
GENERATION_MAX_OUTPUT_TOKENS=900

# --- Jobs ------------------------------------------------------------------
# Analysis runs on an in-process queue. A stated limit, not a hidden one.
JOB_WORKER_CONCURRENCY=2
JOB_QUEUE_MAX_DEPTH=50
JOB_TIMEOUT_SECONDS=900

# --- Limits ---
MAX_UPLOAD_BYTES=10485760
MAX_DOCUMENT_PAGES=40
MAX_DOCUMENT_CHARS=400000
MAX_QUESTION_CHARS=1000
MAX_CONTEXT_CHARS=12000
MAX_EXCERPT_CHARS=600
LLM_MAX_OUTPUT_TOKENS=1024
MAX_ROLES_PER_WORKSPACE=25
RATE_LIMIT_UPLOADS_PER_HOUR=30
RATE_LIMIT_GENERATIONS_PER_HOUR=60

# --- Retention ---
DOCUMENT_RETENTION_DAYS=30

# --- Ops ---
LOG_LEVEL=INFO
