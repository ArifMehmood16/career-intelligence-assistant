# Optional overlay for host runs. The combined settings live in
# config/app.env.example, which `make setup` copies to config/app.env.
#
# Use this file for machine-specific values you do not want in config/app.env:
# a different Postgres, a different port, a key you are testing with.
# `make run` loads config/app.env first and then this file, so entries here win.
# Compose reads config/app.env directly via --env-file and ignores this one.

# DATABASE_URL=postgresql+psycopg://career:career@localhost:5433/career_assistant
# API_PORT=8000
# WEB_PORT=3000
